# Caddyfile de Configuración para N8N y Prensi Bot con SSL Automático
# Asegúrate de definir DOMAIN_NAME en tu archivo .env (ej: DOMAIN_NAME=prensi.macroint.net)

{$DOMAIN_NAME:prensi.macroint.net} {
    # Redirección del endpoint HTTP de alertas de Prensi Bot (PM2 en Host, puerto 3000)
    handle /send-message* {
        reverse_proxy host.docker.internal:3000
    }

    # Redirección general para n8n
    handle {
        reverse_proxy n8n-main:5678
    }

    # Cabeceras de seguridad
    header {
        X-Frame-Options "SAMEORIGIN"
        X-XSS-Protection "1; mode=block"
        X-Content-Type-Options "nosniff"
    }

    # Habilitar compresión de respuestas gzip y zstd
    encode zstd gzip
}

