# --- CONFIGURACIÓN DEL SISTEMA ---
# El dominio público configurado para tu instancia (ej: n8n.tudominio.com o n8n.duckdns.org)
DOMAIN_NAME=tu-dominio.com

# --- BASE DE DATOS POSTGRES ---
POSTGRES_USER=n8n_admin
POSTGRES_PASSWORD=genera_una_contrasena_segura_aqui
POSTGRES_DB=n8n_prod_db

# --- CLAVE DE ENCRIPTACIÓN DE N8N ---
# Clave aleatoria para cifrar credenciales internamente en la base de datos de N8N.
# IMPORTANTE: No la cambies una vez configurada la base de datos o perderás las credenciales guardadas.
# Puedes generarla en Linux con el comando: openssl rand -hex 24
N8N_ENCRYPTION_KEY=genera_una_clave_hexadecimal_larga_aqui

# --- CONFIGURACIÓN DEL BOT DE WHATSAPP ---
# Puerto local en el que el bot expone el servidor HTTP interno
PORT=3000

# ID de la carpeta contenedora en Google Drive donde se guardarán las fotos/videos
PARENT_FOLDER_ID=1Q9Oi0PNtdMugEfYyB7Bn3m5poD0orB9e

# JID del grupo de WhatsApp oficial de Prensa (donde se envían reportes)
REPORTE_GROUP_JID=120363250224178634@g.us

# JID de WhatsApp del Administrador (donde se envían alertas de error y notificaciones de OCI)
ADMIN_NUMBER_JID=5493624408292@s.whatsapp.net

# ID de la Planilla de Google Sheets para Efemérides e Instituciones
SPREADSHEET_ID=1tu_id_de_google_sheets_aqui


